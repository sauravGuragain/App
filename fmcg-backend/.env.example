# Copy to .env and adjust. Never commit the real .env.
PROJECT_NAME=FMCG Platform
API_V1_PREFIX=/api/v1

# --- Database ---
POSTGRES_USER=fmcg
POSTGRES_PASSWORD=fmcg_secret
POSTGRES_DB=fmcg
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_to_a_long_random_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# --- CORS (comma-separated) ---
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:8080

# --- First admin (seeded on first startup if users table is empty) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme123
FIRST_ADMIN_NAME=System Admin

# --- Firebase Cloud Messaging (Phase 13) ---
# Path to the FCM service-account JSON. Leave blank until Phase 13.
FCM_CREDENTIALS_FILE=
